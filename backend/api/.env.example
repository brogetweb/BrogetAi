NODE_ENV=development
PORT=3000
# Add the Vercel site URLs here after deploy, comma-separated.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,*
# Local: mongodb://127.0.0.1:27017/berogetai
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/berogetai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/berogetai
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=berogetai
JWT_ACCESS_SECRET=replace-with-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SUPER_ADMIN_EMAIL=admin@brogetai.com
SUPER_ADMIN_PASSWORD=Desk@1024
SUPER_ADMIN_NAME=Super Admin
TRIPJACK_BASE_URL=
TRIPJACK_CLIENT_ID=
TRIPJACK_CLIENT_SECRET=

# AO Pay Credit (agent CIBIL) — separate from flights
AOPAY_CREDIT_REPORT_URL=https://api.aopay.in/api/AOP/CreditAnalytics/Report
AOPAY_REGISTRATION_ID=
AOPAY_CLIENT_SECRET=
AOPAY_PUBLIC_KEY=
AOPAY_PRIVATE_KEY=

# BOS / AO Pay Flight API V1 UAT (Book by Broget AI)
# Local: BOS_FLIGHT_MOCK=true (no IP / no live BOS). Later: false + whitelist IP.
BOS_FLIGHT_MOCK=true
BOS_FLIGHT_BASE_URL=https://travel.bospay.co.in/api/V1/Air/Travel
BOS_FLIGHT_REGISTRATION_ID=AOP-1006
BOS_FLIGHT_CLIENT_SECRET=
BOS_FLIGHT_PUBLIC_KEY=
# Only required when BOS_FLIGHT_MOCK=false
BOS_FLIGHT_IP_ADDRESS=
BOS_FLIGHT_IMEI=353535353535353

# Flight customer checkout uses Broget Pay (same key as wallet top-up).
# Webhook path: /api/v1/book/flights/pay/webhook
# Markup: domestic 4% + GST 18% on fee; international 7% + GST 18% on fee.

SIP_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
BROGETPAY_BASE_URL=https://gateway.brogetpay.com/api
BROGETPAY_API_KEY=
PUBLIC_API_URL=http://65.2.205.197
BOOK_API_PUBLIC_URL=http://127.0.0.1:3000/api/v1
# Temporary. Set to false when agents should add real Broget Pay money only.
WALLET_TEST_CREDIT=true
EMAIL_PROVIDER=
