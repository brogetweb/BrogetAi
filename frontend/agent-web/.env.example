# Base URL of the Broget AI API (no trailing slash).
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Production EC2 (Elastic IP). Note: an https site (e.g. Vercel) cannot call http —
# run agent-web locally over http, or put TLS on the API first.
# NEXT_PUBLIC_API_BASE_URL=http://65.2.205.197/api/v1
