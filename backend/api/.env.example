NODE_ENV=development
PORT=3000
# Add the Vercel site URLs here after deploy, comma-separated.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,*
# Local: mongodb://127.0.0.1:27017/berogetai
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/berogetai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/berogetai
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=berogetai
JWT_ACCESS_SECRET=replace-with-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SUPER_ADMIN_EMAIL=admin@brogetai.com
SUPER_ADMIN_PASSWORD=Desk@1024
SUPER_ADMIN_NAME=Super Admin
TRIPJACK_BASE_URL=
TRIPJACK_CLIENT_ID=
TRIPJACK_CLIENT_SECRET=

# AO Pay (BOS Center) - TransUnion CIBIL Report V2 Hybrid (agent CIBIL)
# Docs: https://readapi.aopay.co.in/TransunionCibilReport  |  keys: https://readapi.aopay.co.in/Authorization.aspx
# Generate Client Secret + Public Key ON THE SERVER:  node scripts/aopay-credentials.js <RegistrationID>
# Server's Indian static IP must be whitelisted by AO Pay.
AOPAY_CIBIL_URL=https://api.aopay.co.in/api/AOP/V2/Transunion/Score/Hybrid
AOPAY_REGISTRATION_ID=
AOPAY_CLIENT_SECRET=
AOPAY_PUBLIC_KEY=
AOPAY_PRIVATE_KEY=
# Request/response log for AO Pay production sign-off (PAN & phone masked)
AOPAY_LOG_DIR=logs

# BOS / AO Pay Flight API V1 UAT (Book by Broget AI)
# Local: BOS_FLIGHT_MOCK=true (no IP / no live BOS). Later: false + whitelist IP.
BOS_FLIGHT_MOCK=true
BOS_FLIGHT_BASE_URL=https://travel.bospay.co.in/api/V1/Air/Travel
BOS_FLIGHT_REGISTRATION_ID=AOP-1006
BOS_FLIGHT_CLIENT_SECRET=
BOS_FLIGHT_PUBLIC_KEY=
# Only required when BOS_FLIGHT_MOCK=false
BOS_FLIGHT_IP_ADDRESS=
BOS_FLIGHT_IMEI=353535353535353

# Flight customer checkout uses Broget Pay (same key as wallet top-up).
# Webhook path: /api/v1/book/flights/pay/webhook/<BROGETPAY_WEBHOOK_SECRET>
# Markup: domestic 4% + GST 18% on fee; international 7% + GST 18% on fee.

SIP_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
BROGETPAY_BASE_URL=https://gateway.brogetpay.com/api
BROGETPAY_API_KEY=
# Required. Callbacks are refused without it. Generate with: openssl rand -hex 32
# Wallet paths: /api/v1/wallet/payin/webhook/<secret> and /api/v1/wallet/payout/webhook/<secret>
BROGETPAY_WEBHOOK_SECRET=
# Razorpay - wallet top-up (agent "Add money").
# Razorpay dashboard -> Account & Settings -> API Keys. rzp_test_* = test mode, rzp_live_* = live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended. Razorpay dashboard -> Webhooks -> URL <PUBLIC_API_URL>/api/v1/wallet/razorpay/webhook
# events: payment.captured, order.paid. Use the same secret here.
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_API_URL=https://65.2.205.197.sslip.io
BOOK_API_PUBLIC_URL=http://127.0.0.1:3000/api/v1
# Temporary. Set to false when agents should add real Broget Pay money only.
EMAIL_PROVIDER=
